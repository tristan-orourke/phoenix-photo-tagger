<.simple_form :let={f} for={@changeset} action={@action} multipart id="new_photo_form">
  <.error :if={@changeset.action}>
    Oops, something went wrong! Please check the errors below.
  </.error>
  <%!-- <.input field={f[:name]} type="text" label="Name" /> --%>
  <.input field={f[:folder_id]} type="select" label="Folder" 
    required options={Enum.map(@folders, &([key: &1.name, value: &1.id]))} />
  <.input field={f[:images]} type="file" label="Image" multiple required />
  <.input field={f[:group]} type="text" label="Group"/>
  <input class="hidden" type="text" name="photo[file_metadata]" id="new_photo_form_file_metadata" />
  <div class="mt-2">
    <label class="block text-sm font-semibold leading-6 text-zinc-800">Also cross-list to</label>
    <div class="mt-1 flex flex-wrap gap-x-4 gap-y-1">
      <%= for folder <- @folders do %>
        <label class="flex items-center gap-1.5 text-sm text-zinc-900">
          <input type="checkbox" name="photo[cross_list_folder_ids][]" value={folder.id}
                 class="rounded border-zinc-300 text-zinc-900 focus:ring-zinc-900" />
          <%= folder.name %>
        </label>
      <% end %>
    </div>
  </div>
  <:actions>
    <.button>Save Photo</.button>
  </:actions>
</.simple_form>
